# Telegram
TELEGRAM_BOT_TOKEN=

# SQL Server example:
# sqlserver://user:password@db.example.com:1433?database=KnowMe&encrypt=true&TrustServerCertificate=false
SQLSERVER_DSN=

# Runtime
APP_ENV=development
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Logging
# debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=logs/knowme.log
LOG_MAX_SIZE_MB=20
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
